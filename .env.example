# =============================================================================
# Helios POC — variables de entorno
# =============================================================================
# Cada TS_AUTHKEY_* se genera en https://login.tailscale.com/admin/settings/keys
# Tipe: reusable, pre-tageada con el tag correspondiente, sin expiración corta.
# Para las personas (Diego, Rafa, etc.) NO se genera authkey — se loguean con
# SSO via Google Workspace (o Authentik en este POC), pero como el POC simula
# la post-condición "ya están logueados", los creamos con authkey reusable sin
# tag (serían user-owned nodes).
# =============================================================================

# ---- Servicios con tag (authkeys pre-tageadas) ----
TS_AUTHKEY_ADMIN_PORTAL=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_IDENTITY_BRIDGE=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_API_GATEWAY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_CUSTOMER_PORTAL=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_PRIMARY_DB=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_WAREHOUSE_DB=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_ML_PLATFORM=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_WAREHOUSE_JOB=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_OBSERVABILITY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_EKS_GATEWAY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Personas (authkeys sin tag — user-owned nodes) ----
# En prod: estos nodos no existirían; las laptops reales se loguean con SSO.
# Acá los simulamos para poder correr la matriz de verificación sin tener 9
# laptops reales disponibles.
TS_AUTHKEY_DIEGO=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_RAFA=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_SAM=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_LENA=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_CARLA=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_TOMAS=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_NINA=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_AUTHKEY_EVE=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- DB credentials (defaults — Terraform/MiniStack sobrescribe en runtime) ----
PRIMARY_DB_PASSWORD=change-me-local-poc-primary
WAREHOUSE_DB_PASSWORD=change-me-local-poc-warehouse

# ---- Identity Provider (Authentik) ----
# Esta sección solo aplica si vas a usar el IdP simulado. En prod, estos valores
# apuntan a Google Workspace real.
AUTHENTIK_URL=http://localhost:9000
AUTHENTIK_BOOTSTRAP_TOKEN=  # se genera con scripts/bootstrap.sh
HELIOS_IDP_DOMAIN=helios.example

# ---- Tailscale API (para generar authkeys programáticamente) ----
TAILSCALE_API_KEY=tskey-api-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAILSCALE_TAILNET=  # tu tailnet name, ej: githubusercontent-com/cesar

# ---- MiniStack (Secrets Manager simulado) ----
MINISTACK_ENDPOINT=http://localhost:4566
SECRETS_MANAGER_SECRET_ID=helios/poc/secrets

# ---- ngrok (para exponer Authentik a Tailscale SaaS) ----
# Obtené tu authtoken de https://dashboard.ngrok.com/get-started/your-authtoken
# Si no lo completás, ngrok no va a poder levantar
NGROK_AUTHTOKEN=
